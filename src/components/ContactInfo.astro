---
import gmailIcon from '../assets/Gmail_icon_(2020).svg';
import discordIcon from '../assets/discord-icon-svgrepo-com.svg';
---

<section class="contact-info" aria-label="Contact information">
	<div class="contact-method">
		<img src={gmailIcon.src} alt="Gmail" />
		<span>yichen.sun444@gmail.com</span>
	</div>
	<div class="contact-method">
		<img src={discordIcon.src} alt="Discord" />
		<span>soapsws</span>
	</div>
</section>

<style>
	.contact-info {
		display: flex;
		align-items: flex-start;
		justify-content: center;
		gap: 1.95rem;
		width: 100%;
	}

	.contact-method {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.45rem;
		color: #aaa7a0;
		font-size: 0.85rem;
		line-height: 1.2;
		white-space: nowrap;
	}

	.contact-method img {
		width: 1.4rem;
		height: 1.4rem;
	}
</style>
